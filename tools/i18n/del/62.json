[
 {
  "i": 9080,
  "f": "js/city/life.js",
  "k": "Hej! Hur är det?"
 },
 {
  "i": 9081,
  "f": "js/city/life.js",
  "k": "Bara bra! Och du?"
 },
 {
  "i": 9082,
  "f": "js/city/life.js",
  "k": "Jo tack, det rullar på."
 },
 {
  "i": 9083,
  "f": "js/city/life.js",
  "k": "Vi ses! Hej då!"
 },
 {
  "i": 9084,
  "f": "js/city/life.js",
  "k": "Hej! Vart är du på väg?"
 },
 {
  "i": 9085,
  "f": "js/city/life.js",
  "k": "Ska bara handla lite."
 },
 {
  "i": 9086,
  "f": "js/city/life.js",
  "k": "Ha det bra!"
 },
 {
  "i": 9087,
  "f": "js/city/life.js",
  "k": "Ja, i går! Pommesen var jättegoda."
 },
 {
  "i": 9088,
  "f": "js/city/life.js",
  "k": "Då går jag dit i kväll."
 },
 {
  "i": 9089,
  "f": "js/city/life.js",
  "k": "Gör det! Hej då!"
 },
 {
  "i": 9090,
  "f": "js/city/life.js",
  "k": "Vilken dag, va?"
 },
 {
  "i": 9091,
  "f": "js/city/life.js",
  "k": "Ja, perfekt för en promenad."
 },
 {
  "i": 9092,
  "f": "js/city/life.js",
  "k": "Jag ska till parken."
 },
 {
  "i": 9093,
  "f": "js/city/life.js",
  "k": "Trevligt! Vi ses!"
 },
 {
  "i": 9094,
  "f": "js/city/life.js",
  "k": "Hej! Länge sedan!"
 },
 {
  "i": 9095,
  "f": "js/city/life.js",
  "k": "Ja verkligen! Hur mår familjen?"
 },
 {
  "i": 9096,
  "f": "js/city/life.js",
  "k": "Alla mår fint, tack."
 },
 {
  "i": 9097,
  "f": "js/city/life.js",
  "k": "Hälsa dem! Hej då!"
 },
 {
  "i": 9098,
  "f": "js/city/life.js",
  "k": "Har du sett den nya butiken?"
 },
 {
  "i": 9099,
  "f": "js/city/life.js",
  "k": "Nej, var ligger den?"
 },
 {
  "i": 9100,
  "f": "js/city/life.js",
  "k": "Borta vid torget."
 },
 {
  "i": 9101,
  "f": "js/city/life.js",
  "k": "Jag ska titta förbi!"
 },
 {
  "i": 9102,
  "f": "js/city/life.js",
  "k": "Jag ska på bio i kväll."
 },
 {
  "i": 9103,
  "f": "js/city/life.js",
  "k": "Vad ska du se?"
 },
 {
  "i": 9104,
  "f": "js/city/life.js",
  "k": "Fotbollsfilmen!"
 },
 {
  "i": 9105,
  "f": "js/city/life.js",
  "k": "Den är bra. Ha det!"
 },
 {
  "i": 9106,
  "f": "js/city/life.js",
  "k": "Hej! Fin tröja!"
 },
 {
  "i": 9107,
  "f": "js/city/life.js",
  "k": "Tack, köpte den på Kläders."
 },
 {
  "i": 9108,
  "f": "js/city/life.js",
  "k": "Snyggt! Hej då!"
 },
 {
  "i": 9109,
  "f": "js/city/life.js",
  "k": "Tog du bussen hit?"
 },
 {
  "i": 9110,
  "f": "js/city/life.js",
  "k": "Nej, jag gick. Det är så fint väder."
 },
 {
  "i": 9111,
  "f": "js/city/life.js",
  "k": "Jag borde också gå mer."
 },
 {
  "i": 9112,
  "f": "js/city/life.js",
  "k": "Häng med nästa gång!"
 },
 {
  "i": 9113,
  "f": "js/city/life.js",
  "k": "Har du fikat?"
 },
 {
  "i": 9114,
  "f": "js/city/life.js",
  "k": "Inte än. Kaféet har kanelbullar i dag."
 },
 {
  "i": 9115,
  "f": "js/city/life.js",
  "k": "Då går vi dit!"
 },
 {
  "i": 9116,
  "f": "js/city/life.js",
  "k": "Ja, kom!"
 },
 {
  "i": 9117,
  "f": "js/city/life.js",
  "k": "Ja! Kurragömma?"
 },
 {
  "i": 9118,
  "f": "js/city/life.js",
  "k": "Du räknar först!"
 },
 {
  "i": 9119,
  "f": "js/city/life.js",
  "k": "Ett, två, tre …"
 },
 {
  "i": 9120,
  "f": "js/city/life.js",
  "k": "Har du ett husdjur?"
 },
 {
  "i": 9121,
  "f": "js/city/life.js",
  "k": "Ja, en kanin som heter Bus."
 },
 {
  "i": 9122,
  "f": "js/city/life.js",
  "k": "Vad söt! Jag har en katt."
 },
 {
  "i": 9123,
  "f": "js/city/life.js",
  "k": "Vi kan leka ihop sen!"
 },
 {
  "i": 9124,
  "f": "js/city/life.js",
  "k": "Jag också! Ska vi till lekplatsen?"
 },
 {
  "i": 9125,
  "f": "js/city/life.js",
  "k": "Ja! Jag tävlar dig dit!"
 },
 {
  "i": 9126,
  "f": "js/city/life.js",
  "k": "Jag vinner!"
 },
 {
  "i": 9127,
  "f": "js/city/life.js",
  "k": "Såg du kurserna i dag?"
 },
 {
  "i": 9128,
  "f": "js/city/life.js",
  "k": "Upp tre procent!"
 },
 {
  "i": 9129,
  "f": "js/city/life.js",
  "k": "Vi måste köpa mer."
 },
 {
  "i": 9130,
  "f": "js/city/life.js",
  "k": "Ring mig sen!"
 },
 {
  "i": 9131,
  "f": "js/city/life.js",
  "k": "Hinner du ett möte klockan tre?"
 },
 {
  "i": 9132,
  "f": "js/city/life.js",
  "k": "Bara om det blir kort."
 },
 {
  "i": 9133,
  "f": "js/city/life.js",
  "k": "Tjugo minuter, max."
 },
 {
  "i": 9134,
  "f": "js/city/life.js",
  "k": "Okej, vi ses då."
 },
 {
  "i": 9135,
  "f": "js/city/life.js",
  "k": "Jag glömde paraplyet."
 },
 {
  "i": 9136,
  "f": "js/city/life.js",
  "k": "Spring hem då!"
 },
 {
  "i": 9137,
  "f": "js/city/life.js",
  "k": "Det ska klarna i eftermiddag."
 },
 {
  "i": 9138,
  "f": "js/city/life.js",
  "k": "Säger vem?"
 },
 {
  "i": 9139,
  "f": "js/city/life.js",
  "k": "Väderskylten på torget!"
 },
 {
  "i": 9140,
  "f": "js/city/life.js",
  "k": "Då litar jag på den."
 },
 {
  "i": 9141,
  "f": "js/city/life.js",
  "k": "Snö! Äntligen!"
 },
 {
  "i": 9142,
  "f": "js/city/life.js",
  "k": "Ska vi bygga en snögubbe?"
 },
 {
  "i": 9143,
  "f": "js/city/life.js",
  "k": "Ja! I parken!"
 },
 {
  "i": 9144,
  "f": "js/city/life.js",
  "k": "Kom!"
 },
 {
  "i": 9145,
  "f": "js/city/life.js",
  "k": "Akta, det är halt!"
 },
 {
  "i": 9146,
  "f": "js/city/life.js",
  "k": "Tack, jag halkade nyss."
 },
 {
  "i": 9147,
  "f": "js/city/life.js",
  "k": "Ta det lugnt."
 },
 {
  "i": 9148,
  "f": "js/city/life.js",
  "k": "Det ska jag."
 },
 {
  "i": 9149,
  "f": "js/city/life.js",
  "k": "Jättefina! Vad vattnar du med?"
 },
 {
  "i": 9150,
  "f": "js/city/life.js",
  "k": "Regnvatten från tunnan."
 },
 {
  "i": 9151,
  "f": "js/city/life.js",
  "k": "Smart! Hej då!"
 },
 {
  "i": 9152,
  "f": "js/city/life.js",
  "k": "Vi grillar i kväll, kommer du?"
 },
 {
  "i": 9153,
  "f": "js/city/life.js",
  "k": "Gärna! Vad ska jag ta med?"
 },
 {
  "i": 9154,
  "f": "js/city/life.js",
  "k": "Bara dig själv!"
 },
 {
  "i": 9155,
  "f": "js/city/life.js",
  "k": "Perfekt, vi ses!"
 },
 {
  "i": 9156,
  "f": "js/city/life.js",
  "k": "Ja, det växer så det knakar."
 },
 {
  "i": 9157,
  "f": "js/city/life.js",
  "k": "Jag lånar din klippare i helgen?"
 },
 {
  "i": 9158,
  "f": "js/city/life.js",
  "k": "Klart du får!"
 }
]